{
  "description": "Concept-learning eval set. Fixture texts live in this directory; src/ must not hardcode them. Each case names its corpus files explicitly.",
  "cases": [
    {"id": "familiar-classification", "kind": "classify",
     "observation": {"name": "cup", "attributes": {"material": "ceramic", "function": "drinking"}},
     "expect": {"verdict": "match", "best": "cup", "is_a": [["cup", "container"], ["cup", "drinkware"]]}},
    {"id": "novel-concept", "kind": "novel",
     "observation": {"name": "solar_cooker", "parents": ["entity"], "attributes": {"power_source": "solar", "function": "heating"}},
     "expect": {"verdict": "novel", "creates_provisional": true}},
    {"id": "similar-but-different", "kind": "classify",
     "observation": {"name": "deco_cup", "attributes": {"material": "ceramic", "has_handle": true, "function": "decoration"}},
     "expect": {"verdict": "ambiguous", "best": "cup", "conflict_key": "function", "no_auto_drinkware": true}},
    {"id": "missing-key-attribute", "kind": "research",
     "corpus": [], "target": "cup", "key": "location",
     "expect": {"result": "inconclusive", "no_version_change": true, "no_attribute_added": true}},
    {"id": "conflicting-evidence", "kind": "research-conflict",
     "corpus": ["eval_glass_a.txt", "eval_glass_b.txt"], "target": "cup", "key": "material",
     "expect": {"action": "record_conflict", "verified_kept": "ceramic"}},
    {"id": "dependent-sources", "kind": "research",
     "corpus": ["eval_cup_a.txt", "eval_cup_a_copy.txt", "eval_cup_a_reword.txt"], "target": "cup", "key": "location",
     "expect": {"result": "inconclusive", "no_attribute_added": true, "candidate_claim": true}},
    {"id": "independent-sources", "kind": "research",
     "corpus": ["eval_cup_a.txt", "eval_cup_b.txt"], "target": "cup", "key": "location",
     "expect": {"result": "learned", "value": "kitchen", "status": "hypothesis", "min_sources": 2}},
    {"id": "distractor-text", "kind": "research",
     "corpus": ["eval_decoy.txt"], "target": "cup", "key": "location",
     "expect": {"result": "inconclusive", "no_attribute_added": true}},
    {"id": "post-split-classification", "kind": "split-then-classify",
     "corpus": ["eval_bowl_a.txt", "eval_bowl_b.txt", "eval_bottle_a.txt", "eval_bottle_b.txt"],
     "observation": {"name": "new_jar", "attributes": {"material": "glass", "has_lid": true}},
     "expect": {"split_parent": "vessel", "best": "bottle", "subgroup_member": true}},
    {"id": "regression-old-cases", "kind": "regression",
     "expect": {"cup_container": true, "cup_drinkware": true, "familiar_still_match": true}}
  ]
}
